# Conexão do banco.
#
# LOCAL: a URL que o `npx prisma dev` imprime ao subir o Postgres de
# desenvolvimento (veja o README).
#
# RAILWAY: NÃO cole uma URL literal aqui — o endereço do banco muda e o valor
# abaixo aponta para a própria máquina, onde não há Postgres nenhum. Crie a
# variável referenciando o serviço do banco:
#     DATABASE_URL = ${{Postgres.DATABASE_URL}}
# trocando "Postgres" pelo nome que o serviço tem no seu projeto.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/cao_idoso?schema=public"

# sessão do admin (32+ caracteres aleatórios em produção)
SESSION_SECRET="troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres"

# ano fixo do evento — usado no número da carteirinha ("Cão Idoso nº 2026-018")
EVENT_YEAR="2026"
